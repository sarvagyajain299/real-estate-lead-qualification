{
  "name": "LQS - Channel: Telegram inbound",
  "id": "5Vk45QAHDDyTes0W",
  "active": false,
  "description": "Entry point. Normalises the Telegram payload into the seven standard fields (external_message_id is chat_id:message_id so the dedup index is globally unique) and calls LQS - Core: handle inbound message with mode each and waitForSubWorkflow true.",
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true,
    "errorWorkflow": "f2C3GiauR1vJiIxw"
  },
  "nodes": [
    {
      "name": "Telegram Inbound",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "CREDENTIAL_ID",
          "name": "telegramApi (set your own)"
        }
      }
    },
    {
      "name": "Normalise Telegram Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "ch",
              "name": "channel",
              "value": "telegram",
              "type": "string"
            },
            {
              "id": "eid",
              "name": "external_id",
              "value": "={{ String($json.message.chat.id) }}",
              "type": "string"
            },
            {
              "id": "emid",
              "name": "external_message_id",
              "value": "={{ String($json.message.chat.id) + \":\" + String($json.message.message_id) }}",
              "type": "string"
            },
            {
              "id": "txt",
              "name": "text",
              "value": "={{ $json.message.text ?? $json.message.caption ?? '' }}",
              "type": "string"
            },
            {
              "id": "dn",
              "name": "display_name",
              "value": "={{ (($json.message.from?.first_name ?? '') + ' ' + ($json.message.from?.last_name ?? '')).trim() }}",
              "type": "string"
            },
            {
              "id": "ts",
              "name": "timestamp",
              "value": "={{ DateTime.fromSeconds($json.message.date).toISO() }}",
              "type": "string"
            },
            {
              "id": "raw",
              "name": "raw_json",
              "value": "={{ JSON.stringify($json) }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Handle Inbound Message",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "each",
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "K0NKtJfBGWcU5vYS",
          "cachedResultName": "LQS - Core: handle inbound message"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "value": {
            "channel": "={{ $json.channel }}",
            "external_id": "={{ $json.external_id }}",
            "external_message_id": "={{ $json.external_message_id }}",
            "text": "={{ $json.text }}",
            "display_name": "={{ $json.display_name }}",
            "timestamp": "={{ $json.timestamp }}",
            "raw_json": "={{ $json.raw_json }}"
          }
        },
        "options": {
          "waitForSubWorkflow": true
        }
      }
    }
  ],
  "connections": {
    "Telegram Inbound": {
      "main": [
        [
          {
            "node": "Normalise Telegram Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalise Telegram Payload": {
      "main": [
        [
          {
            "node": "Handle Inbound Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}