    },
    {
      "name": "Confirm Booking Rows",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        -240
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "with upd as (update lqs.bookings set status = 'confirmed', starts_at = $2::timestamptz, ends_at = $3::timestamptz, calendar_event_id = $4 where id = $1::uuid returning id, conversation_id, lead_id), uc as (update lqs.conversations set status = 'booked', updated_at = now() where id = (select conversation_id from upd) returning id), ul as (update lqs.leads set status = 'booked', updated_at = now() where id = (select lead_id from upd) returning id) select (select id from upd) as booking_id, $4 as calendar_event_id;",
        "options": {
          "queryReplacement": "={{ [$('Validate Chosen Slot').item.json.booking_id, $('Validate Chosen Slot').item.json.start_iso, $('Validate Chosen Slot').item.json.end_iso, $json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "CREDENTIAL_ID",
          "name": "postgres (set your own)"
        }
      }
    },
